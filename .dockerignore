# ============================================
# Docker build-context exclusions
# ============================================
# These are NOT sent to the Docker daemon. Critically, .env (live secrets)
# must never enter a build context or image layer.

# Secrets & environment
.env
.env.*
!.env.example

# VCS
.git
.gitignore
.github

# Python
.venv
__pycache__
*.pyc
*.pyo
*.egg-info
.pytest_cache
.ruff_cache
.mypy_cache
.coverage
htmlcov

# Node
node_modules
.next
.turbo
out
dist
build
*.tsbuildinfo

# Misc
.DS_Store
*.log
