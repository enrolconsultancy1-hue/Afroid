[project]
name = "afroid-orchestrator"
version = "1.0.0"
description = "Afroid Multi-Agent Orchestrator — LangGraph-based code generation pipeline"
requires-python = ">=3.12"
dependencies = [
    "afroid-shared",
    "langgraph>=0.2.0",
    "langchain-core>=0.3.0",
    "langchain-google-genai>=2.0.0",
]

[tool.uv.sources]
afroid-shared = { workspace = true }

[build-system]
requires = ["setuptools>=68"]
build-backend = "setuptools.build_meta"

[tool.setuptools]
packages = ["services.orchestrator.app", "services.orchestrator.app.agents", "services.orchestrator.app.routes", "services.orchestrator.app.schemas", "services.orchestrator.app.services", "services.orchestrator.tests"]
package-dir = {"services.orchestrator.app" = "app", "services.orchestrator.tests" = "tests"}
