# ============================================
# Afroid — Environment Variables Template
# ============================================
# Copy this file to .env.local and fill in values.
# NEVER commit .env.local to version control.
# ============================================

# --- Application ---
APP_ENV=development                         # development | staging | production
APP_DEBUG=true
CORS_ORIGINS=http://localhost:3000,https://app.afroid.io
APP_SECRET_KEY=CHANGE_ME_64_CHAR_HEX        # openssl rand -hex 32

# --- Database (PostgreSQL + pgvector) ---
DATABASE_URL=postgresql+asyncpg://afroid:afroid_dev@localhost:5432/afroid
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# --- MongoDB ---
MONGODB_URL=mongodb://afroid:afroid_dev@localhost:27017/afroid?authSource=admin

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Auth (JWT) ---
JWT_SECRET_KEY=CHANGE_ME_64_CHAR_HEX        # openssl rand -hex 32
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30
JWT_ALGORITHM=HS256

# --- OAuth (Google) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/callback/google   # set prod domain in production

# --- Google Cloud Platform ---
GCP_PROJECT_ID=afroid-dev
GCP_REGION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=             # Path to service account JSON

# --- Vertex AI / Gemini ---
VERTEX_AI_PROJECT=afroid-dev
VERTEX_AI_LOCATION=us-central1
GEMINI_MODEL=gemini-flash-latest

# --- Google Cloud Storage ---
GCS_BUCKET_ARTIFACTS=afroid-artifacts-dev
GCS_BUCKET_DOCUMENTS=afroid-documents-dev
GCS_BUCKET_UPLOADS=afroid-uploads-dev

# --- Google Pub/Sub ---
PUBSUB_PROJECT_ID=afroid-dev
PUBSUB_EMULATOR_HOST=localhost:8085         # For local dev

# --- Stripe ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID_STARTER=price_...
STRIPE_PRICE_ID_PRO=price_...
STRIPE_PRICE_ID_ENTERPRISE=price_...

# --- Sentry (Error Monitoring) ---
SENTRY_DSN=

# --- Frontend (Next.js public vars) ---
NEXT_PUBLIC_API_URL=http://localhost:8090
NEXT_PUBLIC_WS_URL=ws://localhost:8014
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXTAUTH_SECRET=CHANGE_ME                   # openssl rand -hex 32
NEXTAUTH_URL=http://localhost:3000
