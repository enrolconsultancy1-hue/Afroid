{
  "manifest_version": 3,
  "name": "geezcodE ፩</> — Sovereign AI Code & Grant Copilot",
  "version": "1.0.0",
  "description": "Capture code snippets, autofill African grant forms, audit legal compliance, and dispatch to geezcodE IDE seamlessly.",
  "permissions": [
    "activeTab",
    "storage",
    "contextMenus",
    "scripting"
  ],
  "host_permissions": [
    "http://localhost:3000/*",
    "http://localhost:8000/*",
    "http://localhost:8002/*",
    "http://localhost:8003/*",
    "http://localhost:8004/*",
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "geezcodE ፩</> Copilot",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
